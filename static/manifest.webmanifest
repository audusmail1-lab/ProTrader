    { "src": "/static/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Trading terminal", "url": "/mobile", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Desktop dashboard", "url": "/dashboard" }
  ]
}
