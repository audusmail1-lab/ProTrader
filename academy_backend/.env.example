# Documentation template only. Set through your environment/host secret manager.
ACADEMY_ORIGIN=https://protraderacademy.company
ACADEMY_MAIL_ENABLED=false
ACADEMY_SMTP_HOST=smtp.resend.com
ACADEMY_SMTP_PORT=587
ACADEMY_SMTP_USER=resend
ACADEMY_SMTP_PASSWORD=YOUR_PRIVATE_RESEND_API_KEY
# Proposed sender; enable only after Resend verifies protraderacademy.company.
ACADEMY_SMTP_FROM=Pro Trader Academy <academy@protraderacademy.company>
ACADEMY_SMTP_SECURITY=starttls
ACADEMY_NOTIFICATION_RECIPIENT=your-notification-address@example.com
ACADEMY_DATA_DIR=/var/data/academy
ACADEMY_ENROLLMENT_OPEN=false

# Optional: actual verified HTTPS URL for the existing Pro Trader app.
ACADEMY_APP_URL=https://protrader-jaoy.onrender.com/
